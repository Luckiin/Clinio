# ============================================================
# CLINIO - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# Supabase - Obtenha em https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# URL pública da aplicação (para redirecionamentos de email)
NEXT_PUBLIC_URL=https://app.clinio.com.br

# WhatsApp Business API (opcional - para envio de mensagens)
WHATSAPP_API_TOKEN=seu-token-aqui
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id

# Email (opcional - para envio de emails)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=sua-senha-smtp
EMAIL_FROM=noreply@clinio.com.br

# Segredo para assinatura de webhooks
WEBHOOK_SECRET=seu-segredo-webhook-aqui

# Segredo para autenticar chamadas do Vercel Cron (gere um UUID aleatório)
CRON_SECRET=seu-segredo-cron-aqui
